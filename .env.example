# Copy this file to ".env" and fill in your real values.
# .env is for local secrets only — never commit it to git.

SECRET_KEY=change-this-to-a-long-random-string

# Postgres example:
DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/compliance_management

# MySQL example:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/compliance_db
